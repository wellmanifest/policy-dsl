DOCUMENT SUBACTOR_RPI5
VERSION 1
LANGUAGE PL
MODE STRICT
PURPOSE "Specyfikacja hosta Raspberry Pi 5 dla portalu / lekkiego edge Subactor"
POLICY "subactor.host/rpi5/v1"

HOST_KIND = "RPI5"
ARCH_ARM64 = "arm64"
ENGINE_DOCKER = "docker"
ENGINE_PODMAN = "podman"
STORAGE_NVME = "nvme"
STORAGE_SSD = "ssd"
STORAGE_MICROSD = "microsd"
ROLE_PORTAL = "PORTAL_EDGE"
ROLE_LAB = "LAB_SMOKE"
OS_RPI = "raspberry_pi_os_64"
OS_UBUNTU = "ubuntu_arm64"

MIN_RAM_GIB = 8
RECOMMENDED_RAM_GIB = 8
MIN_VCPU = 4
MIN_DISK_GIB = 64
RECOMMENDED_DISK_GIB = 128

ALLOWED_ARCH = [ARCH_ARM64]
ALLOWED_ENGINE = [ENGINE_DOCKER, ENGINE_PODMAN]
ALLOWED_OS = [OS_RPI, OS_UBUNTU]
ALLOWED_DATA_STORAGE = [STORAGE_NVME, STORAGE_SSD]
ALLOWED_ROLE = [ROLE_PORTAL, ROLE_LAB]

ASSERT HOST_KIND = "RPI5"
ASSERT MIN_RAM_GIB = 8
ASSERT ALLOWED_ARCH = [ARCH_ARM64]

STATES [EVALUATE, FIT, DEGRADED, REJECTED]
TRANSITION EVALUATE -> FIT WHEN HOST_FIT = "LAB" OR HOST_FIT = "PORTAL_EDGE"
TRANSITION EVALUATE -> DEGRADED WHEN HOST_FIT = "DEGRADED"
TRANSITION EVALUATE -> REJECTED WHEN HOST_FIT = "REJECT"

TEMPLATE REJECT_RPI
DO RECORD HOST_FIT "REJECT"
NEXT REJECTED
END

TEMPLATE REJECT_RPI_PORTAL
DO APPLY_TEMPLATE REJECT_RPI
FORBID DEPLOY_PORTAL
END

RULE RPI-PROFILE-REQUIRED TYPE REQUIRED
WHEN NOT (HOST_KIND = "RPI5")
DO APPLY_TEMPLATE REJECT_RPI
DO RECORD REJECT_REASON "WRONG_HOST_PROFILE"
FORBID DEPLOY_PLATFORM
FORBID DEPLOY_FULL_ECOSYSTEM

SCOPE WHEN HOST_KIND = "RPI5"
RULE RPI-ARCH TYPE REQUIRED
WHEN NOT (CPU_ARCH = ARCH_ARM64)
DO APPLY_TEMPLATE REJECT_RPI_PORTAL
DO RECORD REJECT_REASON "RPI5_REQUIRES_ARM64"

RULE RPI-OS TYPE REQUIRED
WHEN NOT (HOST_OS IN ALLOWED_OS)
DO APPLY_TEMPLATE REJECT_RPI_PORTAL
DO RECORD REJECT_REASON "UNSUPPORTED_OS"

RULE RPI-ENGINE TYPE REQUIRED
WHEN NOT (CONTAINER_ENGINE IN ALLOWED_ENGINE)
DO APPLY_TEMPLATE REJECT_RPI_PORTAL
DO RECORD REJECT_REASON "UNSUPPORTED_CONTAINER_ENGINE"

RULE RPI-REJECT-LOW-RAM TYPE REQUIRED
WHEN RAM_GIB < MIN_RAM_GIB
DO APPLY_TEMPLATE REJECT_RPI_PORTAL
DO RECORD REJECT_REASON "RAM_BELOW_MINIMUM"
FORBID DEPLOY_PLATFORM

RULE RPI-FORBID-FULL-PLATFORM TYPE REQUIRED
WHEN HOST_KIND = "RPI5"
DO RECORD PLATFORM_SCOPE "EDGE_OR_LAB_ONLY"
FORBID DEPLOY_FULL_ECOSYSTEM
FORBID DEPLOY_PLATFORM_PRODUCTION
FORBID DEPLOY_HEAVY_DIGITAL_TWIN_STACK
FORBID RUN_LOCAL_LLM_WEIGHTS
FORBID HOST_PLANFILE_HEAVY_WORKLOAD
FORBID HOST_ON_SHARED_PLESK_DOCKER

RULE RPI-LAB-SMOKE TYPE REQUIRED
WHEN ROLE = ROLE_LAB AND RAM_GIB >= MIN_RAM_GIB AND CPU_ARCH = ARCH_ARM64 AND CONTAINER_ENGINE IN ALLOWED_ENGINE
DO RECORD HOST_FIT "LAB"
DO ALLOW DEPLOY_PORTAL_SMOKE
DO ALLOW USE_MICROSD_FOR_LAB_ONLY
DO REQUIRE VOLUME_BACKUP_IF_PERSISTING
FORBID EXPOSE_AS_PUBLIC_SAAS_ORIGIN
NEXT FIT

SCOPE WHEN ROLE = ROLE_PORTAL
RULE RPI-REJECT-MICROSD-DATA TYPE REQUIRED
WHEN STORAGE_KIND = STORAGE_MICROSD
DO APPLY_TEMPLATE REJECT_RPI
DO RECORD REJECT_REASON "MICROSD_NOT_FOR_PRODUCTION_DATA"
FORBID USE_MICROSD_AS_PRIMARY_DATA
FORBID DEPLOY_PORTAL_PRODUCTION

RULE RPI-PORTAL-EDGE TYPE REQUIRED
WHEN RAM_GIB >= MIN_RAM_GIB AND DISK_GIB >= RECOMMENDED_DISK_GIB AND CPU_ARCH = ARCH_ARM64 AND CONTAINER_ENGINE IN ALLOWED_ENGINE AND STORAGE_KIND IN ALLOWED_DATA_STORAGE AND HOST_OS IN ALLOWED_OS
DO RECORD HOST_FIT "PORTAL_EDGE"
DO ALLOW DEPLOY_PORTAL
DO ALLOW SERVE_SUB_ACTOR_STATIC
DO REQUIRE VOLUME_BACKUP
DO REQUIRE DISK_MONITORING
DO REQUIRE PINNED_COMPONENT_LOCK
DO REQUIRE SEPARATE_PRODUCTION_SERVER_FOR_PLATFORM
FORBID DEPLOY_PLATFORM_PRODUCTION
NEXT FIT

RULE RPI-DEGRADED-DISK TYPE REQUIRED
WHEN DISK_GIB >= MIN_DISK_GIB AND DISK_GIB < RECOMMENDED_DISK_GIB AND STORAGE_KIND IN ALLOWED_DATA_STORAGE
DO RECORD HOST_FIT "DEGRADED"
DO ALLOW DEPLOY_PORTAL_SMOKE
DO REQUIRE DISK_MONITORING
FORBID DEPLOY_PORTAL_PRODUCTION
NEXT DEGRADED
END
END
