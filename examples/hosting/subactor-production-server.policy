DOCUMENT SUBACTOR_PRODUCTION_SERVER
VERSION 1
LANGUAGE PL
MODE STRICT
PURPOSE "Specyfikacja hosta produkcyjnego Platformy Subactor (VPS / bare metal)"
POLICY "subactor.host/production-server/v1"

HOST_KIND = "PRODUCTION_SERVER"
ARCH_AMD64 = "amd64"
ARCH_ARM64 = "arm64"
ENGINE_DOCKER = "docker"
ENGINE_PODMAN = "podman"
STORAGE_NVME = "nvme"
STORAGE_SSD = "ssd"
ROLE_PLATFORM = "PLATFORM_RUNTIME"
ROLE_PORTAL = "PORTAL_EDGE"
TOPOLOGY_PRODUCTION = "production"

MIN_VCPU = 4
RECOMMENDED_VCPU = 8
MIN_RAM_GIB = 16
RECOMMENDED_RAM_GIB = 32
MIN_DISK_GIB = 100
RECOMMENDED_DISK_GIB = 200
PUBLIC_HTTP_PORT = 80
PUBLIC_HTTPS_PORT = 443

ALLOWED_ARCH = [ARCH_AMD64, ARCH_ARM64]
ALLOWED_ENGINE = [ENGINE_DOCKER, ENGINE_PODMAN]
ALLOWED_STORAGE = [STORAGE_NVME, STORAGE_SSD]
ALLOWED_ROLE = [ROLE_PLATFORM, ROLE_PORTAL]

ASSERT HOST_KIND = "PRODUCTION_SERVER"
ASSERT MIN_RAM_GIB = 16
ASSERT RECOMMENDED_RAM_GIB = 32
ASSERT MIN_VCPU = 4
ASSERT RECOMMENDED_VCPU = 8

STATE EVALUATE
STATE FIT
STATE DEGRADED
STATE REJECTED
TRANSITION EVALUATE -> FIT WHEN HOST_FIT = "RECOMMENDED" OR HOST_FIT = "MINIMUM"
TRANSITION EVALUATE -> DEGRADED WHEN HOST_FIT = "DEGRADED"
TRANSITION EVALUATE -> REJECTED WHEN HOST_FIT = "REJECT"

RULE SRV-PROFILE-REQUIRED TYPE REQUIRED
WHEN NOT (HOST_KIND = "PRODUCTION_SERVER")
DO RECORD HOST_FIT "REJECT"
DO RECORD REJECT_REASON "WRONG_HOST_PROFILE"
FORBID DEPLOY_PLATFORM
FORBID DEPLOY_FULL_ECOSYSTEM
NEXT REJECTED

RULE SRV-ARCH TYPE REQUIRED
WHEN HOST_KIND = "PRODUCTION_SERVER" AND NOT (CPU_ARCH IN ALLOWED_ARCH)
DO RECORD HOST_FIT "REJECT"
DO RECORD REJECT_REASON "UNSUPPORTED_ARCH"
FORBID DEPLOY_PLATFORM
NEXT REJECTED

RULE SRV-ENGINE TYPE REQUIRED
WHEN HOST_KIND = "PRODUCTION_SERVER" AND NOT (CONTAINER_ENGINE IN ALLOWED_ENGINE)
DO RECORD HOST_FIT "REJECT"
DO RECORD REJECT_REASON "UNSUPPORTED_CONTAINER_ENGINE"
FORBID DEPLOY_PLATFORM
NEXT REJECTED

RULE SRV-STORAGE TYPE REQUIRED
WHEN HOST_KIND = "PRODUCTION_SERVER" AND NOT (STORAGE_KIND IN ALLOWED_STORAGE)
DO RECORD HOST_FIT "REJECT"
DO RECORD REJECT_REASON "UNSUPPORTED_STORAGE"
FORBID DEPLOY_PLATFORM
FORBID USE_MICROSD_AS_PRIMARY_DATA
NEXT REJECTED

RULE SRV-REJECT-LOW-RAM TYPE REQUIRED
WHEN HOST_KIND = "PRODUCTION_SERVER" AND RAM_GIB < MIN_RAM_GIB
DO RECORD HOST_FIT "REJECT"
DO RECORD REJECT_REASON "RAM_BELOW_MINIMUM"
FORBID DEPLOY_PLATFORM
FORBID DEPLOY_FULL_ECOSYSTEM
NEXT REJECTED

RULE SRV-REJECT-LOW-CPU TYPE REQUIRED
WHEN HOST_KIND = "PRODUCTION_SERVER" AND VCPU < MIN_VCPU
DO RECORD HOST_FIT "REJECT"
DO RECORD REJECT_REASON "VCPU_BELOW_MINIMUM"
FORBID DEPLOY_PLATFORM
NEXT REJECTED

RULE SRV-REJECT-LOW-DISK TYPE REQUIRED
WHEN HOST_KIND = "PRODUCTION_SERVER" AND DISK_GIB < MIN_DISK_GIB
DO RECORD HOST_FIT "REJECT"
DO RECORD REJECT_REASON "DISK_BELOW_MINIMUM"
FORBID DEPLOY_PLATFORM
NEXT REJECTED

RULE SRV-PORTS TYPE REQUIRED
WHEN HOST_KIND = "PRODUCTION_SERVER" AND ROLE = ROLE_PLATFORM AND NOT (PUBLIC_HTTP = TRUE AND PUBLIC_HTTPS = TRUE)
DO RECORD HOST_FIT "DEGRADED"
DO RECORD REJECT_REASON "MISSING_PUBLIC_80_443"
DO REQUIRE EXTERNAL_LOAD_BALANCER OR HIGH_PORTS_INGRESS
FORBID BIND_CONTROL_PORT_8181_PUBLIC
NEXT DEGRADED

RULE SRV-PODMAN-ROOTLESS TYPE REQUIRED
WHEN HOST_KIND = "PRODUCTION_SERVER" AND CONTAINER_ENGINE = ENGINE_PODMAN AND ROOTLESS = TRUE
DO RECORD HOST_FIT "DEGRADED"
DO REQUIRE INGRESS_HTTP_PORT_HIGH
DO REQUIRE INGRESS_HTTPS_PORT_HIGH
DO REQUIRE EXTERNAL_LOAD_BALANCER
FORBID BIND_PRIVILEGED_PORTS_WITHOUT_CAP
NEXT DEGRADED

RULE SRV-MINIMUM-FIT TYPE REQUIRED
WHEN HOST_KIND = "PRODUCTION_SERVER" AND RAM_GIB >= MIN_RAM_GIB AND RAM_GIB < RECOMMENDED_RAM_GIB AND VCPU >= MIN_VCPU AND DISK_GIB >= MIN_DISK_GIB AND CPU_ARCH IN ALLOWED_ARCH AND CONTAINER_ENGINE IN ALLOWED_ENGINE AND STORAGE_KIND IN ALLOWED_STORAGE
DO RECORD HOST_FIT "MINIMUM"
DO RECORD DEPLOYMENT_TOPOLOGY TOPOLOGY_PRODUCTION
DO ALLOW DEPLOY_PLATFORM
DO ALLOW DEPLOY_PORTAL
DO REQUIRE VOLUME_BACKUP
DO REQUIRE DISK_MONITORING
FORBID DEPLOY_HEAVY_DIGITAL_TWIN_STACK
FORBID RUN_LOCAL_LLM_WEIGHTS
FORBID HOST_ON_SHARED_PLESK_DOCKER
NEXT FIT

RULE SRV-RECOMMENDED-FIT TYPE REQUIRED
WHEN HOST_KIND = "PRODUCTION_SERVER" AND RAM_GIB >= RECOMMENDED_RAM_GIB AND VCPU >= RECOMMENDED_VCPU AND DISK_GIB >= RECOMMENDED_DISK_GIB AND CPU_ARCH IN ALLOWED_ARCH AND CONTAINER_ENGINE IN ALLOWED_ENGINE AND STORAGE_KIND IN ALLOWED_STORAGE
DO RECORD HOST_FIT "RECOMMENDED"
DO RECORD DEPLOYMENT_TOPOLOGY TOPOLOGY_PRODUCTION
DO ALLOW DEPLOY_PLATFORM
DO ALLOW DEPLOY_PORTAL
DO ALLOW DEPLOY_FULL_ECOSYSTEM
DO ALLOW DEPLOY_OBSERVABILITY
DO REQUIRE VOLUME_BACKUP
DO REQUIRE DISK_MONITORING
DO REQUIRE PINNED_COMPONENT_LOCK
FORBID HOST_ON_SHARED_PLESK_DOCKER
FORBID COPY_DEV_ENV_WITHOUT_AUDIT
NEXT FIT

RULE SRV-PLESK-EDGE-ONLY TYPE REQUIRED
WHEN HOST_KIND = "PRODUCTION_SERVER" AND PLESK_EDGE = TRUE
DO ALLOW USE_PLESK_FOR_DNS_TLS_MAIL_WWW
DO ALLOW USE_PLESK_AS_REVERSE_PROXY
FORBID RUN_COMPOSE_STACK_INSIDE_PLESK
FORBID TREAT_PLESK_AS_PLATFORM_RUNTIME
DO REQUIRE SEPARATE_DOCKER_HOST
