{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wellmanifest.dev/schemas/sales/subactor-sales-catalog.v2.schema.json",
  "title": "Subactor Sales Catalog v2",
  "description": "Sales-owned plan data only. Names, prices, currencies, operation entitlements and copy HOME in subactor/offer and are read from the locked HOME catalog.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plans"
  ],
  "properties": {
    "schema": {
      "const": "subactor.sales/catalog/v2"
    },
    "plans": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/plan"
      }
    }
  },
  "$defs": {
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_id",
        "public_code",
        "legacy_public_codes",
        "payment_card_required",
        "eligible_promo_codes"
      ],
      "properties": {
        "plan_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 64
        },
        "public_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 64
        },
        "legacy_public_codes": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 8,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "maxLength": 64
          }
        },
        "payment_card_required": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "eligible_promo_codes": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_-]{1,64}$"
          }
        }
      }
    }
  }
}
