      "python3 tests/policy_dsl_check.py validate-markdown examples/valid/CONTRIBUTING.md",
      "python3 tests/policy_dsl_check.py ir examples/valid/contributing.policy --check-schema",
      "python3 tests/policy_dsl_check.py self-test",
      "python3 -m unittest discover -s tests -p 'test_*.py'"
    ],
    "validExamples": ["examples/valid/contributing.policy", "examples/valid/CONTRIBUTING.md"],
