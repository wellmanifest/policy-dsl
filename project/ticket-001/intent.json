      "responsibilityChanges": true,
      "interfaceChanges": [
        "Publish Policy DSL v1 EBNF and stable diagnostic codes",
        "Publish closed wellmanifest.policy/ir/v1 JSON Schema",
        "Publish constrained policy candidate GBNF and deterministic CONTRIBUTING.md validation for propose-only policy data"
      ],
      "dataChanges": [
        "Normalize rule conditions and actions into typed expression/sequence AST nodes",
        "Separate native Policy DSL version from consuming document profile versions",
        "Represent legacy environment declarations as compatibility bindings rather than Env DSL semantics"
