DOCUMENT SUBACTOR_SALES
VERSION 1
LANGUAGE PL
MODE STRICT
PURPOSE "Wspólne reguły sprzedaży i promocji Subactor"
POLICY "subactor.sales/policy/v1"

METERING_UNIT = "AGENT_OPERATION"
PROMO_NOCC100 = "NOCC100"
PLAN_BASIC = "saas-start"
PLAN_TWIN_PLUS = "prepaid-actions"
KNOWN_PROMO_CODES = [PROMO_NOCC100]
PROMO_NOCC100_ELIGIBLE_PLANS = [PLAN_BASIC]

ASSERT PROMO_NOCC100 IN KNOWN_PROMO_CODES
ASSERT PLAN_BASIC IN PROMO_NOCC100_ELIGIBLE_PLANS

RULE SALES-PROMO-NONE TYPE REQUIRED
WHEN REQUESTED_PROMO = ""
DO RECORD PROMOTION_ELIGIBILITY "NONE"
DO RECORD EFFECTIVE_PROMO ""
DO RECORD PROMOTION_PRESENTATION "HIDDEN"
DO RECORD PROMOTION_REASON "NO_PROMO"

RULE SALES-PROMO-NOCC100-BASIC TYPE REQUIRED
WHEN REQUESTED_PROMO = PROMO_NOCC100 AND SELECTED_PLAN IN PROMO_NOCC100_ELIGIBLE_PLANS
DO RECORD PROMOTION_ELIGIBILITY "ELIGIBLE"
DO RECORD EFFECTIVE_PROMO PROMO_NOCC100
DO RECORD PROMOTION_PRESENTATION "VISIBLE"
DO RECORD PROMOTION_REASON "ELIGIBLE_BASIC"
DO RECORD CARD_REQUIRED FALSE
DO ALLOW APPLY_PROMOTION

RULE SALES-PROMO-NOCC100-NON-BASIC TYPE REQUIRED
WHEN REQUESTED_PROMO = PROMO_NOCC100 AND NOT (SELECTED_PLAN IN PROMO_NOCC100_ELIGIBLE_PLANS)
DO RECORD PROMOTION_ELIGIBILITY "INELIGIBLE"
DO RECORD EFFECTIVE_PROMO ""
DO RECORD PROMOTION_PRESENTATION "HIDDEN"
DO RECORD PROMOTION_REASON "PLAN_NOT_ELIGIBLE"
DO REQUIRE PROMOTION_SANITIZED
FORBID APPLY_PROMOTION PROMO_NOCC100
FORBID DISPLAY_PROMOTION PROMO_NOCC100

RULE SALES-PROMO-UNKNOWN TYPE REQUIRED
WHEN REQUESTED_PROMO != "" AND NOT (REQUESTED_PROMO IN KNOWN_PROMO_CODES)
DO RECORD PROMOTION_ELIGIBILITY "UNKNOWN"
DO RECORD EFFECTIVE_PROMO ""
DO RECORD PROMOTION_PRESENTATION "HIDDEN"
DO RECORD PROMOTION_REASON "UNKNOWN_PROMO_CODE"
DO REQUIRE PROMOTION_SANITIZED
FORBID APPLY_PROMOTION REQUESTED_PROMO
FORBID DISPLAY_PROMOTION REQUESTED_PROMO

RULE SALES-TWIN-PLUS-PRESENTATION TYPE REQUIRED
WHEN SELECTED_PLAN = PLAN_TWIN_PLUS
DO REPORT "OPERATIONS_PURCHASED_SEPARATELY"
FORBID DISPLAY_OPERATION_LABEL "Brak"
