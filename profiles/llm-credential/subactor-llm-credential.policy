DOCUMENT SUBACTOR_LLM_CREDENTIAL
VERSION 1
LANGUAGE EN
MODE STRICT
PURPOSE "Credential-source LLM routing strategies for SubLLM"
POLICY "subactor.llm/credential-strategy/v1"

ENV_FILE ".env" OPTIONAL
SECRET CURSOR_API_KEY TYPE STRING FROM ENV REQUIRED REDACT
SECRET ZAI_API_KEY TYPE STRING FROM ENV REQUIRED REDACT
SECRET OPENROUTER_API_KEY TYPE STRING FROM ENV REQUIRED REDACT
VARIABLE SUBLLM_PROVIDER_ORDER TYPE STRING FROM ENV DEFAULT ""

STRATEGY_CURSOR = "cursor"
STRATEGY_ZAI = "zai"
STRATEGY_OPENROUTER = "openrouter"
TRANSPORT_CURSOR_SDK = "cursor-sdk"
TRANSPORT_OPENAI_COMPATIBLE = "openai-compatible"
MODEL_GPT_56_SOL = "gpt-5.6-sol"
MODEL_GROK_46 = "grok-4.6"
MODEL_GLM_52 = "glm-5.2"
MODEL_GROK_45 = "grok-4.5"
MODEL_GEMINI_36_FLASH = "gemini-3.6-flash"
MODEL_DEEPSEEK_V4_PRO = "deepseek-v4-pro"
MODEL_QWEN37_PLUS = "qwen3.7-plus"
CURSOR_ALLOWED IN [MODEL_GPT_56_SOL, MODEL_GROK_46]
ZAI_ALLOWED IN [MODEL_GLM_52]
OPENROUTER_ALLOWED IN [MODEL_GLM_52, MODEL_GROK_45, MODEL_GEMINI_36_FLASH, MODEL_DEEPSEEK_V4_PRO, MODEL_QWEN37_PLUS]
CURSOR_ONLY IN [MODEL_GPT_56_SOL, MODEL_GROK_46]

ASSERT MODEL_GPT_56_SOL IN CURSOR_ALLOWED
ASSERT MODEL_GROK_46 IN CURSOR_ALLOWED
ASSERT MODEL_GLM_52 IN ZAI_ALLOWED
ASSERT MODEL_GLM_52 IN OPENROUTER_ALLOWED
ASSERT NOT (MODEL_GPT_56_SOL IN OPENROUTER_ALLOWED)
ASSERT NOT (MODEL_GROK_46 IN OPENROUTER_ALLOWED)

STATE SELECT
STATE ROUTED
STATE REJECTED
TRANSITION SELECT -> ROUTED WHEN STRATEGY_SELECTED = TRUE
TRANSITION SELECT -> REJECTED WHEN STRATEGY_SELECTED = FALSE

RULE LLM-CURSOR-STRATEGY TYPE REQUIRED
WHEN CREDENTIAL_SOURCE = "CURSOR" AND REQUESTED_MODEL IN CURSOR_ALLOWED
DO RECORD SELECTED_STRATEGY STRATEGY_CURSOR
DO RECORD SELECTED_PROVIDER STRATEGY_CURSOR
DO RECORD SELECTED_TRANSPORT TRANSPORT_CURSOR_SDK
DO RECORD SELECTED_MODEL REQUESTED_MODEL
DO ALLOW ROUTE_CURSOR_SDK
FORBID ROUTE_OPENROUTER_WIRE REQUESTED_MODEL
NEXT ROUTED

RULE LLM-ZAI-STRATEGY TYPE REQUIRED
WHEN CREDENTIAL_SOURCE = "ZAI" AND REQUESTED_MODEL IN ZAI_ALLOWED
DO RECORD SELECTED_STRATEGY STRATEGY_ZAI
DO RECORD SELECTED_PROVIDER STRATEGY_ZAI
DO RECORD SELECTED_TRANSPORT TRANSPORT_OPENAI_COMPATIBLE
DO RECORD SELECTED_MODEL REQUESTED_MODEL
DO ALLOW ROUTE_ZAI_CODING_PLAN
NEXT ROUTED

RULE LLM-OPENROUTER-STRATEGY TYPE REQUIRED
WHEN CREDENTIAL_SOURCE = "OPENROUTER" AND REQUESTED_MODEL IN OPENROUTER_ALLOWED
DO RECORD SELECTED_STRATEGY STRATEGY_OPENROUTER
DO RECORD SELECTED_PROVIDER STRATEGY_OPENROUTER
DO RECORD SELECTED_TRANSPORT TRANSPORT_OPENAI_COMPATIBLE
DO RECORD SELECTED_MODEL REQUESTED_MODEL
DO ALLOW ROUTE_OPENROUTER
NEXT ROUTED

RULE LLM-FORBID-OPENROUTER-SOL TYPE REQUIRED
WHEN CREDENTIAL_SOURCE = "OPENROUTER" AND REQUESTED_MODEL IN CURSOR_ONLY
DO RECORD SELECTED_STRATEGY ""
DO RECORD REJECT_REASON "CURSOR_ONLY_MODEL"
FORBID ROUTE_OPENROUTER
FORBID ROUTE_OPENROUTER_WIRE MODEL_GPT_56_SOL
NEXT REJECTED

RULE LLM-FORBID-MISSING-CREDENTIAL TYPE REQUIRED
WHEN CREDENTIAL_PRESENT = FALSE
DO RECORD SELECTED_STRATEGY ""
DO RECORD REJECT_REASON "MISSING_CREDENTIAL"
FORBID ROUTE_CURSOR_SDK
FORBID ROUTE_ZAI_CODING_PLAN
FORBID ROUTE_OPENROUTER
NEXT REJECTED

RULE LLM-FORBID-UNKNOWN-MODEL-FOR-SOURCE TYPE REQUIRED
WHEN CREDENTIAL_PRESENT = TRUE AND NOT (REQUESTED_MODEL IN CURSOR_ALLOWED OR REQUESTED_MODEL IN ZAI_ALLOWED OR REQUESTED_MODEL IN OPENROUTER_ALLOWED)
DO RECORD SELECTED_STRATEGY ""
DO RECORD REJECT_REASON "UNKNOWN_MODEL"
FORBID ROUTE_CURSOR_SDK
FORBID ROUTE_ZAI_CODING_PLAN
FORBID ROUTE_OPENROUTER
NEXT REJECTED
